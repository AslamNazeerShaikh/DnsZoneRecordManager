{
  "$schema": "https://opencode.ai/config.json",
  "version": "1.0.0",
  "model": "opencode/muse-spark-1.3-contributor-free",
  "small_model": "opencode/muse-spark-1.3-contributor-free",
  "provider": {
    "opencode": {
      "models": {
        "muse-spark-1.3-contributor-free": {
          "options": {
            "reasoningEffort": "high"
          }
        }
      }
    }
  },
  "project": {
    "name": "DnsZoneRecordManager",
    "description": "DNS Zones + DNS Records manager (Query, Create, Modify, Delete) for a non-technical customer persona. Solution1: ASP.NET Core MVC (.NET 10) + Generic Repository/Unit of Work + In-Memory. Solution2: ASP.NET Core Web API (.NET 10, hand-rolled CQRS without MediatR, EF Core + SQLite) + Next.js 16 + React 19 + TypeScript + Tailwind CSS 4.",
    "type": "dotnet"
  },
  "instructions": ["docs/REQUIREMENTS_ANALYSIS.md", "docs/TOOLCHAIN_AND_PACKAGES.md"],
  "agents": {
    "default": "dns-zone-assistant",
    "list": [
      "dns-zone-assistant",
      "code-reviewer",
      "test-writer",
      "documentation-writer"
    ]
  },
  "skills": {
    "enabled": [
      "api-design",
      "testing-strategy"
    ]
  },
  "commands": {
    "custom": [
      "dotnet-build",
      "dotnet-test",
      "dotnet-run",
      "dotnet-clean",
      "dotnet-publish",
      "dotnet-lint",
      "build",
      "test",
      "lint",
      "format",
      "run",
      "clean"
    ]
  },
  "permission": {
    "read": "allow",
    "write": "allow",
    "edit": "allow",
    "glob": "allow",
    "grep": "allow",
    "task": "allow",
    "bash": {
      "*": "allow",
      "rm -rf *": "deny",
      "sudo *": "deny",
      "chmod 777 *": "deny"
    }
  },
  "lsp": true,
  "plugin": [
    "@dietrichgebert/ponytail",
    ".opencode/plugins/graphify.js"
  ],
  "mcp": {
    "ui-skills": {
      "type": "remote",
      "url": "https://www.ui-skills.com/mcp",
      "enabled": true
    },
    "github": {
      "type": "remote",
      "url": "https://api.githubcopilot.com/mcp/",
      "enabled": true,
      "oauth": false,
      "headers": {
        "Authorization": "Bearer {env:GITHUB_PERSONAL_ACCESS_TOKEN}"
      }
    }
  }
}
