@model RecordIndexViewModel
@{
    ViewData["Title"] = Model.ZoneName == null ? "Records" : $"Records · {Model.ZoneName}";
}

<div class="d-flex justify-content-between align-items-center flex-wrap gap-2 mb-3">
    <h1 class="h3 mb-0">@ViewData["Title"] <span class="badge dns-chip">@Model.Records.Count shown</span></h1>
    <div class="d-flex gap-2">
        <a class="btn btn-outline-secondary" asp-action="Export" asp-route-zoneId="@Model.ZoneId" asp-route-search="@Model.Search" asp-route-type="@Model.Type">Export CSV</a>
        <a class="btn btn-primary" asp-action="Create" asp-route-zoneId="@Model.ZoneId">New record</a>
    </div>
</div>

<div class="card mb-3">
    <div class="card-body">
        <form method="get" class="row g-2 align-items-end">
            <div class="col-12 col-md-4">
                <label class="form-label" for="zoneId">Zone</label>
                <select asp-for="ZoneId" class="form-select" asp-items="Model.ZoneOptions">
                    <option value="">All zones</option>
                </select>
            </div>
            <div class="col-12 col-md-4">
                <label class="form-label" for="search">Search</label>
                <input id="search" name="search" value="@Model.Search" class="form-control" placeholder="name or data…" />
            </div>
            <div class="col-6 col-md-2">
                <label class="form-label" for="type">Type</label>
                <select asp-for="Type" class="form-select" asp-items="Model.TypeOptions">
                    <option value="">All types</option>
                </select>
            </div>
            <div class="col-6 col-md-auto d-flex gap-2">
                <button type="submit" class="btn btn-outline-primary">Apply</button>
                <a class="btn btn-outline-secondary" asp-action="Index">Clear</a>
            </div>
        </form>
    </div>
</div>

@if (Model.ZoneName != null)
{
    <div class="card mb-3">
        <div class="card-body d-flex align-items-center gap-3 flex-wrap">
            <strong>@Model.ZoneName</strong>
            <div class="progress dns-meter flex-grow-1" role="progressbar" aria-valuenow="@Model.RecordCount" aria-valuemin="0" aria-valuemax="10" aria-label="Record count">
                <div class="progress-bar" style="width: @(Model.RecordCount * 10)%"></div>
            </div>
            <span class="badge dns-chip">@Model.RecordCount / 10 records</span>
            <span class="badge dns-chip">@Model.NsCount NS</span>
        </div>
    </div>
}

@if (Model.Records.Count == 0)
{
    <div class="card"><div class="card-body text-center text-muted py-5">No records match. Adjust the filters or add a record.</div></div>
}
else
{
    <div class="card">
        <div class="table-responsive">
            <table class="table table-hover align-middle mb-0">
                <thead>
                    <tr><th>FQDN</th><th>Name</th><th>Type</th><th>TTL</th><th>Data</th><th>Modified (UTC)</th><th class="text-end">Actions</th></tr>
                </thead>
                <tbody>
                    @foreach (var r in Model.Records)
                    {
                        <tr>
                            <td class="fw-semibold">@r.Fqdn</td>
                            <td><code>@r.Name</code></td>
                            <td><span class="badge dns-type dns-type-@r.Type.ToString().ToLowerInvariant()">@r.Type</span></td>
                            <td>@r.Ttl</td>
                            <td class="dns-data">@r.Data</td>
                            <td><small class="text-muted">@r.UpdatedUtc.ToString("yyyy-MM-dd HH:mm")</small></td>
                            <td class="text-end text-nowrap">
                                <a class="btn btn-sm btn-outline-primary" asp-action="Edit" asp-route-id="@r.Id">Edit</a>
                                <a class="btn btn-sm btn-outline-danger" asp-action="Delete" asp-route-id="@r.Id">Delete</a>
                            </td>
                        </tr>
                    }
                </tbody>
                <tfoot>
                    <tr><td colspan="7" class="text-muted">Total: <strong>@Model.Records.Count</strong> records</td></tr>
                </tfoot>
            </table>
        </div>
    </div>
}
