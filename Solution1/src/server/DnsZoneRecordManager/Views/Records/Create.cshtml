@model RecordFormViewModel
@{
    var editing = Model.Id.HasValue;
    ViewData["Title"] = editing ? "Edit record" : "New record";
    var action = editing ? "Edit" : "Create";
}

<h1 class="h3 mb-3 text-center">@ViewData["Title"]</h1>

<div class="card dns-form-card">
    <div class="card-body">
        <form method="post" asp-action="@action" asp-route-id="@Model.Id">
            @if (editing)
            {
                <input type="hidden" asp-for="Id" />
                <input type="hidden" asp-for="ZoneId" />
                <input type="hidden" asp-for="ZoneName" />
            }
            <div asp-validation-summary="ModelOnly" class="alert alert-danger" role="alert"></div>
            <div class="mb-3">
                <label asp-for="ZoneId" class="form-label">Zone</label>
                @if (editing)
                {
                    <input class="form-control" value="@Model.ZoneName" disabled />
                }
                else
                {
                    <select asp-for="ZoneId" asp-items="Model.ZoneOptions" class="form-select"></select>
                }
                <span asp-validation-for="ZoneId" class="text-danger"></span>
            </div>
            <div class="row g-3">
                <div class="col-12 col-md-6">
                    <label asp-for="Name" class="form-label">Record name</label>
                    <input asp-for="Name" class="form-control" placeholder="@@, www, _dmarc" autocomplete="off" />
                    <span asp-validation-for="Name" class="text-danger"></span>
                </div>
                <div class="col-6 col-md-3">
                    <label asp-for="Type" class="form-label">Type</label>
                    <select asp-for="Type" class="form-select" asp-items="Html.GetEnumSelectList<RecordType>()">
                        <option value="">Pick…</option>
                    </select>
                    <span asp-validation-for="Type" class="text-danger"></span>
                </div>
                <div class="col-6 col-md-3">
                    <label asp-for="Ttl" class="form-label">TTL (seconds)</label>
                    <input asp-for="Ttl" class="form-control" type="number" min="1" placeholder="3600" />
                    <span asp-validation-for="Ttl" class="text-danger"></span>
                </div>
            </div>
            <div class="mb-3 mt-3">
                <label asp-for="Data" class="form-label">Data</label>
                <input asp-for="Data" class="form-control" placeholder="1.2.3.4, hostname, or text" autocomplete="off" />
                <span asp-validation-for="Data" class="text-danger"></span>
                <div class="form-text">A = IPv4 · AAAA = IPv6 · CNAME/NS = hostname · TXT = text. A CNAME name cannot hold other records.</div>
            </div>
            <div class="d-flex gap-2">
                <button type="submit" class="btn btn-primary">Save</button>
                <a class="btn btn-outline-secondary" asp-action="Index" asp-route-zoneId="@(Model.ZoneId > 0 ? Model.ZoneId : null)">Cancel</a>
            </div>
        </form>
    </div>
</div>

<div class="card dns-form-card mt-3">
    <div class="card-body">
        <h2 class="h6">Allowed values</h2>
        <ul class="mb-0 small text-muted">
            <li><strong>Name</strong>: <code>@@</code> for the zone apex, or letters, digits, hyphens, dots (leading <code>_</code> allowed, e.g. <code>_dmarc</code>); max 63 characters.</li>
            <li><strong>A</strong>: IPv4 address, e.g. <code>10.0.0.1</code>.</li>
            <li><strong>AAAA</strong>: IPv6 address, e.g. <code>2001:db8::1</code>.</li>
            <li><strong>CNAME</strong>: hostname, e.g. <code>alias.example.com.</code> — a CNAME name cannot hold any other record.</li>
            <li><strong>NS</strong>: hostname, e.g. <code>ns1.example.com.</code> — every zone keeps at least 4 NS records.</li>
            <li><strong>TXT</strong>: any text up to 1000 characters.</li>
            <li><strong>TTL</strong>: positive whole seconds (common values 300–172800).</li>
            <li>Zones hold at most 10 records; names and zones are lowercase; exact duplicates are rejected.</li>
        </ul>
    </div>
</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}
