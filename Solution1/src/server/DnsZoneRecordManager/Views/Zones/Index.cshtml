@model ZoneIndexViewModel
@{
    ViewData["Title"] = "Zones";
}

<div class="d-flex justify-content-between align-items-center flex-wrap gap-2 mb-3">
    <h1 class="h3 mb-0">Zones <span class="badge dns-chip">@Model.Zones.Count</span></h1>
    <a class="btn btn-primary" asp-action="Create">New zone</a>
</div>

<div class="card mb-3">
    <div class="card-body">
        <form method="get" class="row g-2 align-items-end">
            <div class="col-12 col-md-6">
                <label class="form-label" for="search">Search zones</label>
                <input id="search" name="search" value="@Model.Search" class="form-control" placeholder="e.g. nahuexolab.com" />
            </div>
            <div class="col-12 col-md-auto d-flex gap-2">
                <button type="submit" class="btn btn-outline-primary">Search</button>
                <a class="btn btn-outline-secondary" asp-action="Index">Clear</a>
            </div>
        </form>
    </div>
</div>

@if (Model.Zones.Count == 0)
{
    <div class="card"><div class="card-body text-center text-muted py-5">No zones found. Create your first zone to get started.</div></div>
}
else
{
    <div class="card">
        <div class="table-responsive">
            <table class="table table-hover align-middle mb-0">
                <thead>
                    <tr><th>Name</th><th>Records (n / 10)</th><th>NS</th><th>Updated (UTC)</th><th class="text-end">Actions</th></tr>
                </thead>
                <tbody>
                    @foreach (var z in Model.Zones)
                    {
                        <tr>
                            <td><a asp-controller="Records" asp-action="Index" asp-route-zoneId="@z.Id" class="fw-semibold">@z.Name</a></td>
                            <td style="min-width: 160px">
                                <div class="progress dns-meter" role="progressbar" aria-valuenow="@z.RecordCount" aria-valuemin="0" aria-valuemax="10" aria-label="Record count">
                                    <div class="progress-bar" style="width: @(z.RecordCount * 10)%"></div>
                                </div>
                                <small class="text-muted">@z.RecordCount / 10</small>
                            </td>
                            <td><span class="badge dns-chip">@z.NsCount NS</span></td>
                            <td><small class="text-muted">@z.UpdatedUtc.ToString("yyyy-MM-dd HH:mm")</small></td>
                            <td class="text-end text-nowrap">
                                <a class="btn btn-sm btn-outline-secondary" asp-controller="Records" asp-action="Index" asp-route-zoneId="@z.Id">Records</a>
                                <a class="btn btn-sm btn-outline-primary" asp-action="Edit" asp-route-id="@z.Id">Rename</a>
                                <a class="btn btn-sm btn-outline-danger" asp-action="Delete" asp-route-id="@z.Id">Delete</a>
                            </td>
                        </tr>
                    }
                </tbody>
                <tfoot>
                    <tr><td colspan="5" class="text-muted">Total: <strong>@Model.Zones.Count</strong> zones</td></tr>
                </tfoot>
            </table>
        </div>
    </div>
}
